[Unit]
Description=MiniTV Menu
After=network.target minitv-api.service
Wants=minitv-api.service

[Service]
Type=simple
User=root
WorkingDirectory=__DEVICE_APP_DIR__
ExecStart=/bin/bash __DEVICE_APP_DIR__/start_menu.sh
KillMode=control-group
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
Environment=MINITV_REPO_DIR=__REPO_DIR__
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
