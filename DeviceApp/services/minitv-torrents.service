[Unit]
Description=MiniTV movie torrent downloads
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/transmission-daemon --foreground --config-dir "__REPO_DIR__/MultimediaContent/Torrents/transmission"
Restart=on-failure
RestartSec=5
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="__REPO_DIR__/MultimediaContent/Torrents"

[Install]
WantedBy=multi-user.target
