{
  "expo": {
    "name": "MiniTV Fotos Expo",
    "slug": "minitv-fotos-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "minitvphotos",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101827"
    },
    "ios": {
      "bundleIdentifier": "com.donkicodelab.minitvphotos.expo",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Exporta las fotos que autorices a tu MiniTV, conservando los originales.",
        "NSLocalNetworkUsageDescription": "Conecta por Wi-Fi con tu MiniTV para enviar tus fotos.",
        "PHPhotoLibraryPreventAutomaticLimitedAccessAlert": true,
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.donkicodelab.minitvphotos.expo.prepare"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.donkicodelab.minitvphotos.expo",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101827"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Escanea el QR del dashboard para enlazar tu MiniTV.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/withMiniTV.cjs"
    ],
    "extra": {
      "eas": {
        "projectId": "4c534c7c-2d21-4ae3-a333-4a81d7f3fb6f"
      }
    },
    "owner": "donkikochan"
  }
}
