{
  "name": "minitv-fotos-expo",
  "description": "MiniTV Fotos para Android e iOS con transferencias nativas en segundo plano.",
  "license": "UNLICENSED",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
