  "functions": [
    {
      "context": "MediaCredits.jsx:labels.more",
      "source": "count => `Show ${count} more`"
    },
    {
      "context": "MediaCredits.jsx:labels.episodes",
      "source": "count => `${count} ${count === 1 ? \"episode\" : \"episodes\"}`"
    },
    {
      "context": "omdbLibrary.js:strings.progress",
      "source": "(processed, total) => `${count(processed, \"en\")} of ${count(total, \"en\")} titles checked`"
    },
    {
      "context": "omdbLibrary.js:strings.inventory",
      "source": "(ready, total) => `${count(ready, \"en\")} of ${count(total, \"en\")} titles up to date`"
    },
    {
      "context": "omdbLibrary.js:strings.current",
      "source": "title => `Checking: ${title}`"
    },
    {
      "context": "omdbLibrary.js:strings.completed",
      "source": "job => `${count(job.processed, \"en\")} titles checked; ${count(job.ready, \"en\")} with ratings available.`"
    },
    {
      "context": "omdbLibrary.js:strings.missingIds",
      "source": "value => value === 1 ? \"1 title has no identifier: review its details to update it.\" : `${count(value, \"en\")} titles have no identifier: review their details to update them.`"
    },
    {
      "context": "omdbLibrary.js:strings.failed",
      "source": "value => `${count(value, \"en\")} ${value === 1 ? \"title\" : \"titles\"} could not be checked.`"
    },
    {
      "context": "omdbLibrary.js:strings.unavailable",
      "source": "value => `${count(value, \"en\")} ${value === 1 ? \"title has\" : \"titles have\"} no ratings available on OMDb.`"
    },
    {
      "context": "omdbRatings.js:strings.votes",
      "source": "count => `${formatOmdbVotes(count, \"en\")} votes`"
    }
  ]
